# 未完旅箋 — k3s 部署參數（非機密）
# 複製成 deploy.env 後修改；機密值請走 kubectl create secret，不要寫在這裡。
#
#   cp deploy.env.example deploy.env

# 對外網域。host 上的 nginx 會以此 server_name 收 HTTPS 再轉給 Service。
# 必須與 Discord Developer Portal 的 Redirect URI 完全一致。
# 中文網域 journey-unfinished.夜橘.com 的 punycode 形式。
# 必須用 punycode：Discord Redirect URI、nginx server_name、certbot 都以此為準。
APP_HOST=journey-unfinished.xn--essy41b.com

# 映像 tag。每次改版請遞增，不要重用 latest：
# k3s 用 imagePullPolicy=IfNotPresent，同名 tag 不會重新載入。
IMAGE_TAG=1.0.0

# Service 的 NodePort。叢集沒有 ingress controller（k3s 的 traefik 與 servicelb
# 都在 /etc/rancher/k3s/config.yaml 停用了，因為 host nginx 要獨佔 80/443），
# 所以 nginx 直接 proxy_pass 到這個埠。k8s 預設 NodePort 範圍 30000–32767。
APP_NODEPORT=30300

# 資料量（SQLite + 上傳圖片）
DATA_SIZE=10Gi
