{
  "name": "journey-unfinished",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "未完旅箋：收藏小小旅伴沿途風景與故事的旅行紀錄網站",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "preview": "nuxt preview --host 0.0.0.0",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:e2e && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.0",
    "better-sqlite3": "13.0.1",
    "leaflet": "1.9.4",
    "nuxt": "4.5.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.0.3",
    "@playwright/test": "1.62.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/leaflet": "1.9.21",
    "typescript": "6.0.2",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  },
  "overrides": {
    "archiver": {
      "readdir-glob": "3.0.0"
    },
    "archiver-utils": {
      "glob": "13.0.6"
    }
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  }
}
