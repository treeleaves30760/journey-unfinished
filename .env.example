# Nuxt/Nitro runtime configuration
NUXT_DATABASE_PATH=./data/journey-unfinished.sqlite
NUXT_UPLOAD_DIR=./data/uploads
NUXT_MAX_UPLOAD_BYTES=5242880

# 應用程式前面有幾層「自己可控」的反向代理（例如 Nginx、Cloudflare + Ingress 就是 2）
# 0（預設）代表完全忽略 X-Forwarded-For，只用連線來源位址判斷限流；直接對外時請維持 0
# 設太大等於信任用戶端自己填的值，限流會被繞過；只算你確定會覆寫/附加該 header 的那幾層
NUXT_TRUSTED_PROXY_HOPS=0

# 相容用途的舊設定，等同於 NUXT_TRUSTED_PROXY_HOPS=1；新部署請直接用上面的 hop 數
NUXT_TRUST_PROXY=false

# Discord Developer Portal OAuth2
# Redirect URL 必須與 Portal 設定完全相同，例如 http://localhost:3000/auth/discord
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_DISCORD_CLIENT_ID=
NUXT_DISCORD_CLIENT_SECRET=
NUXT_DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord

# 以半形逗號分隔 Discord User ID；這些帳號登入後會取得管理員權限
NUXT_ADMIN_DISCORD_IDS=
NUXT_SESSION_DAYS=30

# Nitro listener (production preview / container)
HOST=0.0.0.0
PORT=3000
